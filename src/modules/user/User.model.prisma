model User {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  //! auth
  roles       EUserRole[] @default([RECIPIENT])
  email       String?
  password    String?
  is_verified Boolean     @default(false)
  is_active   Boolean     @default(false)
  is_admin    Boolean     @default(false)
  otp_id      Int         @default(0)
  //! end

  //! social
  fb_id     String?
  google_id String?
  //! end

  //! profile
  avatar        String      @default("/images/placeholder.png")
  name          String      @default("Unknown User")
  gender        EGender     @default(OTHER)
  blood_group   BloodGroup?
  date_of_birth DateTime?
  //! end

  //! payment
  balance                 Float     @default(0)
  stripe_customer_id      String?
  stripe_account_id       String?
  is_stripe_connected     Boolean   @default(false)
  subscription_name       String?
  subscription_expires_at DateTime?
  //! end

  seen_messages    Message[]        @relation("SeenMessages")
  messages         Message[]
  chats            Chat[]           @relation("UserChats")
  transactions     Transaction[]
  donor_profile    DonorProfile?
  hospital_profile HospitalProfile?
  verifier_profile VerifierProfile?
  requests         Request[]        @relation("Requester")
  verifications    Verification[]
  donations      Donation[]      @relation("Donor")

  @@index([email], name: "idx_user_email")
  @@index([fb_id], name: "idx_user_fb_id")
  @@index([google_id], name: "idx_user_google_id")
  @@index([roles], name: "idx_user_roles")
  @@index([stripe_customer_id], name: "idx_user_stripe_customer_id")
  @@index([stripe_account_id], name: "idx_user_stripe_account_id")
  @@map("users")
}

enum EUserRole {
  DONOR
  RECIPIENT
  BLOOD_BANK_STAFF
  HOSPITAL_STAFF
  VOLUNTEER
}

enum EGender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  BOMBAY
}
