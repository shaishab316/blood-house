model Donation {
  //! meta keys
  id         String @id @default(uuid())
  request_id String
  donor_id   String
  //! end

  status DonationStatus @default(PLEDGED)

  //! tracking timestamps
  pledged_at   DateTime  @default(now())
  completed_at DateTime?
  canceled_at  DateTime?
  //! end

  request Request @relation(fields: [request_id], references: [id])
  donor   User    @relation("Donor", fields: [donor_id], references: [id])

  @@map("donations")
}

enum DonationStatus {
  PLEDGED
  COMPLETED
  CANCELLED
}
